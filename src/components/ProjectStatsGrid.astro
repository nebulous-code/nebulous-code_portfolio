---
/**
 * ProjectStatsGrid — the four-cell KPI strip for a project.
 *
 * Rendered on the project card and again at the top of the project summary
 * page, so the numbers stay visible while reading the writeup. It's a
 * component rather than duplicated markup for the same reason PageHeader is:
 * two copies of a four-cell grid drift the moment a cell is added.
 *
 * A cell only exists if it can be populated — see DESIGN_DOC §5. "Open PRs"
 * was cut from this grid after it read `0` on every card.
 */

import KpiGrid from './KpiGrid.astro';
import KpiCell from './KpiCell.astro';
import { daysSince, lastPushLabel } from '~/lib/dates';
import type { ProjectActivity, ProjectStats } from '~/lib/github';

interface Props {
  activity?: ProjectActivity | undefined;
  stats?: ProjectStats | undefined;
}

const { activity, stats } = Astro.props;

const days = daysSince(activity?.lastCommitDate);

// Sienna marks a *recent* event, per the accent rules — a push inside the last
// week, or a release that actually exists.
const pushTone = days < 7 ? 'orange' : 'ink';
const releaseTone = stats?.latestRelease ? 'orange' : 'ink';
---

<KpiGrid columns={4}>
  <KpiCell label="last push" tone={pushTone}>{lastPushLabel(days)}</KpiCell>
  <KpiCell label="latest release" tone={releaseTone}>
    {stats?.latestRelease ?? '—'}
  </KpiCell>
  <KpiCell label="total commits">{stats?.totalCommits ?? '—'}</KpiCell>
  <KpiCell label="commits 30d">{stats?.commits30d ?? '—'}</KpiCell>
</KpiGrid>
