---
/**
 * ProjectCard — the most important component on the site.
 *
 * Composes Eyebrow, Badge, KpiGrid, KpiCell, Sparkline, and ActionLink into
 * the project-card pattern from DESIGN_DOC §5.
 *
 * Status is auto-derived from last-commit recency:
 *   pushed in the last 30 days -> active (green)
 *   older or never pushed       -> idle (ink-muted)
 *
 * Several KPI cells show em-dashes for now (latest release, commits 30d,
 * open prs). Those data sources will land in M4. The card is structurally
 * complete; only the values are placeholders.
 */

import ActionLink from './ActionLink.astro';
import Eyebrow from './Eyebrow.astro';
import Badge from './Badge.astro';
import ProjectStatsGrid from './ProjectStatsGrid.astro';
import Sparkline from './Sparkline.astro';
import { getLiveLink } from '~/config/projects';
import { pickFeaturedTech } from '~/lib/stack';
import { daysSince } from '~/lib/dates';
import type { ProjectConfig } from '~/config/projects';
import type { ProjectActivity, ProjectStats } from '~/lib/github';

interface Props {
  project: ProjectConfig;
  activity?: ProjectActivity | undefined;
  stats?: ProjectStats | undefined;
}

const { project, activity, stats } = Astro.props;

// 13 weekly buckets from the data pipeline; empty only if that fetch failed.
const activityWeeks = stats?.activityWeeks ?? [];
const activityTotal = activityWeeks.reduce((sum, p) => sum + p.count, 0);

// A chart of thirteen empty buckets says nothing, so the whole block (label
// included) is dropped. Deliberately keyed off the data rather than the
// active/idle badge: the badge is a 30-day window, so a project paused for a
// month would lose a chart that still holds a quarter of real history.
const hasActivity = activityTotal > 0;

// The live link is the card's primary action, sitting last so it lands on the
// right edge and reads as the button. The summary link stays muted beside it,
// and code isn't here at all — it lives on the summary page as the audit
// trail rather than the pitch.
const liveLink = getLiveLink(project);

// Three at most on a card: at least one measured language and one asserted
// stack entry when both exist. The summary page shows the full list.
const featuredTech = pickFeaturedTech(stats?.languages ?? [], project.stack ?? []);

// Auto-derive active/idle status from last-commit recency. The grid does its
// own labelling from the same helper, so the two can't disagree.
const isActive = daysSince(activity?.lastCommitDate) <= 30;
const statusLabel = isActive ? 'active' : 'idle';
const statusTone = isActive ? 'green' : 'ink';

// Eyebrow content: "PROJECT · ACTIVE" or "PROJECT · IDLE"
const eyebrowText = `project · ${statusLabel}`;
---

<article class="project-card">
  <header class="card-header">
    <div class="title-block">
      <Eyebrow>{eyebrowText}</Eyebrow>
      <h3 class="title">
        <a href={`/projects/${project.slug}`}>{project.name}</a>
      </h3>
    </div>
    <Badge tone={statusTone}>{statusLabel}</Badge>
  </header>

  <p class="description">{project.tagline}</p>

  {featuredTech.length > 0 ? (
    <p class="languages">{featuredTech.join(' · ')}</p>
  ) : null}

  <ProjectStatsGrid activity={activity} stats={stats} />

  <footer class="card-footer">
    {hasActivity ? (
      <div class="sparkline-block">
        <Eyebrow>activity</Eyebrow>
        <Sparkline
          points={activityWeeks}
          unit="commits"
          width={120}
          height={20}
          ariaLabel={`${activityTotal} commits over the last 13 weeks`}
        />
      </div>
    ) : null}
    <div class="actions">
      <ActionLink href={`/projects/${project.slug}`} tone="muted">project summary</ActionLink>
      {liveLink ? (
        <ActionLink href={liveLink.href}>{liveLink.label}</ActionLink>
      ) : null}
    </div>
  </footer>
</article>

<style>
  .project-card {
    background: var(--color-bg-raised);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-5);
  }

  .title-block {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    min-width: 0;
  }

  .title {
    font-family: var(--font-serif);
    font-size: 22px;
    line-height: 1.2;
    font-weight: 500;
    letter-spacing: -0.01em;
    margin: 0;
  }

  .title a {
    color: var(--color-ink);
    text-decoration: none;
  }

  .title a:hover {
    color: var(--color-blue);
  }

  .description {
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.5;
    color: var(--color-ink-muted);
    margin: 0;
  }

  /* Dominant languages, middle-dot separated. Lowercased in CSS so the API's
     casing ("JavaScript") stays intact in the data. */
  .languages {
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1.4;
    text-transform: lowercase;
    color: var(--color-green-text);
    margin: 0;
  }

  .card-footer {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-5);
    margin-top: var(--space-2);
  }

  .sparkline-block {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    min-width: 0;
  }

  /* margin-left keeps the links right-aligned even when the activity block
     is absent, which happens if that fetch fails. */
  .actions {
    display: flex;
    gap: var(--space-5);
    align-items: center;
    white-space: nowrap;
    margin-left: auto;
  }

</style>
