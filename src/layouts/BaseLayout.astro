---
/**
 * BaseLayout — the shell every page inherits.
 *
 * Provides:
 *   - Sticky top nav with active-page indicator and "last deployed" status.
 *     Below 640px the links collapse behind a hamburger, which frees enough
 *     width that the deploy stamp can stay visible on a phone.
 *   - Minimal footer
 *   - <html> chrome, font links, meta
 *   - No imposed content width — pages opt into .container-wide or
 *     .container-narrow themselves so case studies can use a different
 *     width than the home page.
 *
 * Build-time stamps:
 *   import.meta.env.BUILD_TIME — ISO string, set via astro.config.mjs.
 *   Used in the nav status block so visitors see how fresh the site is.
 *
 *   The relative label ("3h ago") is computed in the browser, not here. On a
 *   static build the config and the page render seconds apart, so a
 *   server-computed delta is always ~0 and bakes "just now" into the HTML
 *   permanently — it read "just now" on a week-old deploy. The markup carries
 *   the absolute timestamp in <time datetime>, which is both the no-JS
 *   fallback and the value the inline script reads.
 */

import '~/styles/global.css';
import Logo from '~/components/Logo.astro';

interface Props {
  title: string;
  description?: string;
  /** Absolute or root-relative image for link previews. */
  image?: string;
}

const {
  title,
  description = 'Nicholas — software developer.',
  image = '/png/logo-512.png',
} = Astro.props;

/*
 * Canonical and social metadata.
 *
 * Astro.site comes from astro.config.mjs, which is what makes these absolute —
 * Open Graph and Twitter both require absolute URLs and silently ignore
 * relative ones, so a root-relative path here would produce a link preview
 * with no image and no warning.
 */
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(image, Astro.site);

// Active-page indicator. Compare current path against nav routes.
const path = Astro.url.pathname;
// No "home" entry — the brand mark to the left of these links already goes
// there, and two adjacent controls for the same destination is noise.
const navItems = [
  { href: '/projects', label: 'projects' },
  { href: '/blog', label: 'blog' },
  { href: '/about', label: 'about' },
  { href: '/resume', label: 'resume' },
  { href: '/contact', label: 'contact' },
];
const isActive = (href: string) => {
  if (href === '/') return path === '/';
  return path === href || path.startsWith(`${href}/`);
};

// "Last deployed". Only the absolute timestamp is baked in — see the note in
// the header comment for why the relative label has to be computed client-side.
const buildTime = import.meta.env.BUILD_TIME ?? new Date().toISOString();
const buildDate = new Date(buildTime);
const buildIso = buildDate.toISOString();
const buildAbsolute = `${buildIso.slice(0, 16).replace('T', ' ')} UTC`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="nebulouscode" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/png/logo-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/png/logo-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0f1c2a" />

    <!-- Feed autodiscovery, so readers find it without being told the URL. -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title="nebulouscode"
      href="/rss.xml"
    />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Departure+Mono&family=Recursive:slnt,CASL,MONO,wght@-15..0,0..1,0..1,400..600&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,500;0,8..60,600;1,8..60,400&display=swap"
    />
  </head>
  <body>
    <nav class="site-nav">
      <div class="nav-inner">
        <button
          id="nav-toggle"
          class="nav-toggle"
          type="button"
          aria-label="Menu"
          aria-expanded="false"
          aria-controls="nav-links"
        >
          <span class="bars" aria-hidden="true"></span>
        </button>

        <a
          href="/"
          class="brand"
          aria-label="nebulous-code home"
          aria-current={isActive('/') ? 'page' : undefined}
        >
          <Logo size={22} />
          <span class="brand-text">nebulous-code</span>
        </a>

        <ul id="nav-links" class="nav-links">
          {
            navItems.map((item) => (
              <li>
                <a
                  href={item.href}
                  class:list={['nav-link', { active: isActive(item.href) }]}
                  aria-current={isActive(item.href) ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>

        <div class="status-block">
          <span class="status-dot" aria-hidden="true"></span>
          <span class="status-text">
            deployed <time id="build-time" datetime={buildIso} title={buildAbsolute}>{buildAbsolute}</time>
          </span>
        </div>
      </div>
    </nav>

    <main class="site-main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-inner">
        <span class="footer-mark">
          <Logo size={16} />
          © {new Date().getFullYear()} Nicholas
        </span>
        <a href="https://github.com/nebulous-code" target="_blank" rel="noopener">
          github →
        </a>
      </div>
    </footer>

    {/*
      Turns the baked absolute build time into a relative label, and refreshes
      it every minute so a tab left open doesn't drift. is:inline keeps this in
      the HTML rather than emitting a bundled chunk — it's smaller than the
      request it would otherwise cost. Buckets match the previous server-side
      logic, so the wording is unchanged; it's just accurate now.
    */}
    <script is:inline>
      (function () {
        var el = document.getElementById('build-time');
        if (!el) return;
        var built = Date.parse(el.getAttribute('datetime'));
        if (isNaN(built)) return;
        function render() {
          var mins = Math.round((Date.now() - built) / 60000);
          if (mins < 1) return void (el.textContent = 'just now');
          if (mins < 60) return void (el.textContent = mins + 'm ago');
          var hours = Math.round(mins / 60);
          if (hours < 24) return void (el.textContent = hours + 'h ago');
          el.textContent = Math.round(hours / 24) + 'd ago';
        }
        render();
        setInterval(render, 60000);
      })();
    </script>

    {/*
      Mobile nav toggle. Deliberately a <button> with aria-expanded rather than
      <details>: recent Chrome hides details content via ::details-content with
      content-visibility, which author CSS can't reliably override, so the
      desktop layout would depend on browser internals. Inline for the same
      reason as the script above — no extra request.
    */}
    <script is:inline>
      (function () {
        var btn = document.getElementById('nav-toggle');
        var list = document.getElementById('nav-links');
        if (!btn || !list) return;
        function set(open) {
          btn.setAttribute('aria-expanded', open ? 'true' : 'false');
          list.classList.toggle('open', open);
        }
        btn.addEventListener('click', function (e) {
          // Stop this reaching the document handler below, which would see
          // the opening click as an outside click and close it immediately.
          e.stopPropagation();
          set(btn.getAttribute('aria-expanded') !== 'true');
        });
        // Anything outside the button or the menu closes it. Following a link
        // inside the menu navigates away, so that case takes care of itself.
        document.addEventListener('click', function (e) {
          if (btn.getAttribute('aria-expanded') !== 'true') return;
          if (btn.contains(e.target) || list.contains(e.target)) return;
          set(false);
        });
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') {
            set(false);
            btn.focus();
          }
        });
      })();
    </script>

    <style>
      /*
       * ───── Container utilities ─────
       *
       * Each container also declares --measure, the reading width that ledes
       * and prose inside it cap themselves to. A narrow page is already close
       * to a comfortable measure, so it keeps 640px. A wide page is a
       * dashboard — its text should line up with the charts and cards beside
       * it, not stop halfway across. Components read var(--measure, 640px), so
       * anything outside a container still gets a sane default.
       */
      :global(.container-wide) {
        --measure: 100%;
        max-width: 1100px;
        margin-inline: auto;
        padding-inline: var(--space-8);
      }
      :global(.container-narrow) {
        --measure: 640px;
        max-width: 720px;
        margin-inline: auto;
        padding-inline: var(--space-8);
      }

      /* ───── Site nav ───── */
      .site-nav {
        position: sticky;
        top: 0;
        z-index: 10;
        background: color-mix(in srgb, var(--color-bg) 92%, transparent);
        backdrop-filter: blur(8px);
        border-bottom: 1px solid var(--color-line);
      }

      .nav-inner {
        max-width: 1100px;
        margin-inline: auto;
        padding: var(--space-5) var(--space-8);
        display: flex;
        align-items: center;
        gap: var(--space-9);
        /* Anchors the mobile dropdown. */
        position: relative;
      }

      /*
       * Hamburger. Hidden above 640px, where the links sit inline.
       *
       * Drawn in CSS rather than SVG — DESIGN_DOC §9 rules out decorative SVG
       * iconography, and three borders render more predictably at this size
       * than a glyph that Departure Mono may not carry.
       */
      .nav-toggle {
        display: none;
        background: transparent;
        border: 0;
        padding: var(--space-2) 0;
        color: var(--color-ink-muted);
        cursor: pointer;
        line-height: 0;
      }

      .nav-toggle:hover {
        color: var(--color-ink);
      }

      .bars,
      .bars::before,
      .bars::after {
        display: block;
        width: 16px;
        height: 1px;
        background: currentColor;
      }

      .bars {
        position: relative;
      }

      .bars::before,
      .bars::after {
        content: '';
        position: absolute;
        left: 0;
      }

      .bars::before {
        top: -5px;
      }

      .bars::after {
        top: 5px;
      }

      .brand {
        display: inline-flex;
        align-items: center;
        gap: var(--space-3);
        font-family: var(--font-mono);
        font-size: 13px;
        color: var(--color-ink);
        text-decoration: none;
        letter-spacing: 0.02em;
      }

      .brand:hover {
        color: var(--color-blue);
        text-decoration: none;
      }

      .brand:hover .brand-text {
        color: var(--color-blue);
      }

      .nav-links {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        gap: var(--space-7);
        flex: 1;
      }

      .nav-link {
        font-family: var(--font-mono);
        font-size: 12px;
        color: var(--color-ink-muted);
        text-decoration: none;
        letter-spacing: 0.02em;
        padding-bottom: 2px;
        border-bottom: 1px solid transparent;
        transition: color 120ms ease, border-color 120ms ease;
      }

      .nav-link:hover {
        color: var(--color-ink);
        text-decoration: none;
      }

      .nav-link.active {
        color: var(--color-blue);
        border-bottom-color: var(--color-blue);
      }

      .status-block {
        display: flex;
        align-items: center;
        gap: var(--space-2);
        font-family: var(--font-mono);
        font-size: 10px;
        color: var(--color-ink-faint);
        letter-spacing: 0.06em;
        text-transform: uppercase;
      }

      .status-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--color-green);
      }

      /* ───── Main ───── */
      .site-main {
        padding-block: var(--space-11);
        min-height: calc(100vh - 200px);
      }

      /* ───── Footer ───── */
      .site-footer {
        border-top: 1px solid var(--color-line);
        padding-block: var(--space-7);
        margin-top: var(--space-11);
      }

      .footer-inner {
        max-width: 1100px;
        margin-inline: auto;
        padding-inline: var(--space-8);
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-family: var(--font-mono);
        font-size: 11px;
        color: var(--color-ink-faint);
      }

      .footer-mark {
        display: inline-flex;
        align-items: center;
        gap: var(--space-3);
      }

      .footer-inner a {
        color: var(--color-ink-muted);
        text-decoration: none;
      }

      .footer-inner a:hover {
        color: var(--color-blue);
      }

      /* ───── Mobile ───── */
      /*
       * Below 640px the five nav labels plus the brand needed ~407px of the
       * ~332px available, so the row overflowed and took the page's right
       * gutter with it. Collapsing the links into a dropdown recovers that
       * width — enough that the deploy stamp can come back too.
       */
      @media (max-width: 640px) {
        .nav-inner {
          gap: var(--space-5);
          padding-inline: var(--space-6);
        }

        .nav-toggle {
          display: block;
        }

        /* Out of flow, so the links cost the header row no width at all. */
        .nav-links {
          display: none;
          position: absolute;
          top: 100%;
          left: 0;
          right: 0;
          flex: none;
          flex-direction: column;
          gap: 0;
          background: var(--color-bg);
          border-bottom: 1px solid var(--color-line);
          padding: var(--space-3) var(--space-6) var(--space-6);
        }

        .nav-links.open {
          display: flex;
        }

        .nav-links li {
          padding-block: var(--space-4);
        }

        .nav-link {
          font-size: 14px;
        }

        /* An underline under a full-width row reads as a rule, so the active
           item leans on colour and aria-current instead. */
        .nav-link.active {
          border-bottom-color: transparent;
        }

        .status-block {
          display: flex;
          margin-left: auto;
        }

        .status-text {
          white-space: nowrap;
        }

        :global(.container-wide),
        :global(.container-narrow) {
          padding-inline: var(--space-6);
        }
      }
    </style>
  </body>
</html>
