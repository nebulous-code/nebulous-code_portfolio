---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Eyebrow from '~/components/Eyebrow.astro';
import Logo from '~/components/Logo.astro';
import ProjectCard from '~/components/ProjectCard.astro';
import Prose from '~/components/Prose.astro';
import PushChart from '~/components/PushChart.astro';
import Button from '~/components/Button.astro';
import { getEntry, render } from 'astro:content';
import { GITHUB_USERNAME, getFeaturedProjects } from '~/config/projects';
import { getCommitActivity, getProjectActivity, getProjectStats } from '~/lib/github';

// Build-time data fetch.
const [activity, projectActivity, projectStats] = await Promise.all([
  getCommitActivity(GITHUB_USERNAME, 90),
  getProjectActivity(GITHUB_USERNAME),
  getProjectStats(GITHUB_USERNAME),
]);

// The "currently building" blurb. Rendered through the markdown pipeline so
// paragraph breaks survive — hand-parsing the frontmatter and injecting the
// body via set:html collapsed the blank line between paragraphs.
const nowEntry = await getEntry('now', 'now');
const NowContent = nowEntry ? (await render(nowEntry)).Content : null;

const featured = getFeaturedProjects();
const activityByRepo = new Map(projectActivity.map((p) => [p.repo, p]));
const statsByRepo = new Map(projectStats.map((s) => [s.repo, s]));
---

<BaseLayout title="nebulous-code">
  <div class="container-wide">
    <section class="hero">
      <Logo size={72} ariaLabel="nebulous-code" class="hero-logo" />
      <h1 class="display">Nicholas Licalsi </h1>
      <p class="lede">
        Full-stack developer with a decade of experience and a soft spot for
        reporting, data pipelines, and the tools that make other developers
        faster.
      </p>
      <div class="hero-actions">
        <Button href="/projects">see projects →</Button>
        <Button variant="ghost" href="/about">about me</Button>
      </div>
    </section>

    <section class="section">
      <Eyebrow>recent activity</Eyebrow>
      <div class="section-body">
        <PushChart points={activity} unit="commits" />
      </div>
    </section>

    <section class="section">
      <Eyebrow>currently building</Eyebrow>
      <div class="section-body">
        {NowContent ? <Prose><NowContent /></Prose> : null}
      </div>
    </section>

    <section class="section">
      <Eyebrow>projects</Eyebrow>
      <div class="section-body project-grid">
        {featured.map((project) => (
          <ProjectCard
            project={project}
            activity={activityByRepo.get(project.repo)}
            stats={statsByRepo.get(project.repo)}
          />
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  /* ───── Hero ───── */
  .hero {
    padding-block: var(--space-9) var(--space-11);
  }

  .hero :global(.hero-logo) {
    margin-bottom: var(--space-7);
  }

  .display {
    font-family: var(--font-serif);
    font-size: 48px;
    line-height: 1.1;
    font-weight: 500;
    letter-spacing: -0.01em;
    margin: 0 0 var(--space-7) 0;
    color: var(--color-ink);
  }

  .lede {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 18px;
    line-height: 1.55;
    color: var(--color-ink-muted);
    margin: 0 0 var(--space-9) 0;
    max-width: 640px;
  }

  .hero-actions {
    display: flex;
    gap: var(--space-5);
    align-items: center;
  }

  /* ───── Section pattern ───── */
  .section {
    padding-block: var(--space-9);
    border-top: 1px solid var(--color-line);
  }

  .section-body {
    margin-top: var(--space-7);
  }

  /* ───── Project grid ───── */
  .project-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-7);
  }

  @media (min-width: 800px) {
    .project-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* ───── Mobile ───── */
  @media (max-width: 640px) {
    .display {
      font-size: 36px;
    }
    .lede {
      font-size: 16px;
    }
    .hero-actions {
      flex-wrap: wrap;
    }
  }
</style>
