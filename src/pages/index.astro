---
import BaseLayout from '~/layouts/BaseLayout.astro';
import ActionLink from '~/components/ActionLink.astro';
import Eyebrow from '~/components/Eyebrow.astro';
import Logo from '~/components/Logo.astro';
import ProjectCard from '~/components/ProjectCard.astro';
import Prose from '~/components/Prose.astro';
import PushChart from '~/components/PushChart.astro';
import { getEntry, render } from 'astro:content';
import { GITHUB_USERNAME } from '~/config/projects';
import { getFeaturedProjects, getLatestProjectUpdate } from '~/lib/content';
import { updatedLabel } from '~/lib/dates';
import { getCommitActivity, getProjectActivity, getProjectStats } from '~/lib/github';

// Build-time data fetch.
const [activity, projectActivity, projectStats, latestProjectUpdate] = await Promise.all([
  getCommitActivity(GITHUB_USERNAME, 90),
  getProjectActivity(GITHUB_USERNAME),
  getProjectStats(GITHUB_USERNAME),
  getLatestProjectUpdate(),
]);

// The "currently building" blurb. Rendered through the markdown pipeline so
// paragraph breaks survive — hand-parsing the frontmatter and injecting the
// body via set:html collapsed the blank line between paragraphs.
const nowEntry = await getEntry('now', 'now');
const NowContent = nowEntry ? (await render(nowEntry)).Content : null;

// The blurb is hand-maintained, so stamp it with its own updatedAt rather
// than letting a fresh deploy imply the text is fresh too.
const nowUpdated = nowEntry ? updatedLabel(nowEntry.data.updatedAt) : null;

const featured = await getFeaturedProjects();
const activityByRepo = new Map(projectActivity.map((p) => [p.repo, p]));
const statsByRepo = new Map(projectStats.map((s) => [s.repo, s]));
---

<BaseLayout
  title="nebulous-code"
  description="Nicholas Licalsi — full-stack developer. Projects, writing, and live GitHub activity."
>
  <div class="container-wide">
    <section class="hero">
      <Logo size={72} ariaLabel="nebulous-code" class="hero-logo" />
      <h1 class="display">Nicholas Licalsi </h1>
      <p class="lede">
        All my projects teach me something, which means none of them waste my time. Some were built over months, some in an afternoon, some are still in progress. Live stats from GitHub show what I'm working on today.
      </p>
      <div class="hero-actions">
        <ActionLink href="/projects" size="large">see projects</ActionLink>
        <ActionLink href="/about" tone="muted" size="large">about me</ActionLink>
      </div>
    </section>

    <section class="section">
      <div class="section-heading">
        <h2 class="section-title">Recent Activity</h2>
      </div>
      <div class="section-body">
        <PushChart points={activity} unit="commits" />
      </div>
    </section>

    <section class="section">
      <div class="section-heading">
        {nowUpdated ? <Eyebrow>{nowUpdated}</Eyebrow> : null}
        <h2 class="section-title">Currently Building</h2>
      </div>
      <div class="section-body">
        {NowContent ? <Prose><NowContent /></Prose> : null}
      </div>
    </section>

    <section class="section">
      <div class="section-heading">
        {latestProjectUpdate ? (
          <Eyebrow>{updatedLabel(latestProjectUpdate)}</Eyebrow>
        ) : null}
        <h2 class="section-title">Projects</h2>
      </div>
      <div class="section-body project-grid">
        {featured.map((project) => (
          <ProjectCard
            project={project}
            activity={activityByRepo.get(project.repo)}
            stats={statsByRepo.get(project.repo)}
          />
        ))}
      </div>

      {/* The grid is a subset once anything is unfeatured, with nothing on the
          page saying so. This is the way out. */}
      <div class="section-cta">
        <ActionLink href="/projects">see more projects</ActionLink>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  /* ───── Hero ───── */
  .hero {
    padding-block: var(--space-9) var(--space-11);
  }

  .hero :global(.hero-logo) {
    margin-bottom: var(--space-7);
  }

  .display {
    font-family: var(--font-serif);
    font-size: 48px;
    line-height: 1.1;
    font-weight: 500;
    letter-spacing: -0.01em;
    margin: 0 0 var(--space-7) 0;
    color: var(--color-ink);
  }

  .lede {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 18px;
    line-height: 1.55;
    color: var(--color-ink-muted);
    margin: 0 0 var(--space-9) 0;
    max-width: var(--measure, 640px);
  }

  .hero-actions {
    display: flex;
    gap: var(--space-5);
    align-items: center;
  }

  /* ───── Section pattern ───── */
  .section {
    padding-block: var(--space-9);
    border-top: 1px solid var(--color-line);
  }

  .section-body {
    margin-top: var(--space-7);
  }

  /* Same eyebrow-over-title stack the project cards use, at the same size, so
     a section heading and a card title read as the same level of thing. */
  .section-heading {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .section-title {
    font-family: var(--font-serif);
    font-size: 22px;
    line-height: 1.2;
    font-weight: 500;
    letter-spacing: -0.01em;
    margin: 0;
    color: var(--color-ink);
  }

  .section-cta {
    margin-top: var(--space-8);
  }

  /* ───── Project grid ───── */
  .project-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-7);
  }

  @media (min-width: 800px) {
    .project-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* ───── Mobile ───── */
  @media (max-width: 640px) {
    .display {
      font-size: 36px;
    }
    .lede {
      font-size: 16px;
    }
    .hero-actions {
      flex-wrap: wrap;
    }
  }
</style>
