---
import BaseLayout from '~/layouts/BaseLayout.astro';
import ActionLink from '~/components/ActionLink.astro';
import PageHeader from '~/components/PageHeader.astro';
import PostCard from '~/components/PostCard.astro';
import { getCategoryValues, getPostsByCategory } from '~/lib/content';

export async function getStaticPaths() {
  const values = await getCategoryValues();
  return values.map(({ value, slug }) => ({
    params: { category: slug },
    props: { value },
  }));
}

const { value } = Astro.props;
const { category } = Astro.params;
const posts = await getPostsByCategory(category!);
---

<BaseLayout
  title={`${value} — nebulous-code`}
  description={`${posts.length} post${posts.length === 1 ? '' : 's'} in the ${value} category, by Nicholas Licalsi.`}
>
  <div class="container-wide">
    <PageHeader
      eyebrow="CATEGORY"
      title={value}
      lede={`${posts.length} post${posts.length === 1 ? '' : 's'} in this category.`}
    />

    <section class="section">
      <div class="post-list">
        {posts.map((post) => <PostCard post={post} />)}
      </div>
      <div class="page-cta">
        <ActionLink href="/blog" tone="muted" direction="back">all posts</ActionLink>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .section {
    padding-block: var(--space-10);
  }

  .post-list {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-7);
  }

  .page-cta {
    margin-top: var(--space-9);
  }
</style>
