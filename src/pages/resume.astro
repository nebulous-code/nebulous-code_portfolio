---
import BaseLayout from '~/layouts/BaseLayout.astro';
import ActionLink from '~/components/ActionLink.astro';
import PageHeader from '~/components/PageHeader.astro';
import Prose from '~/components/Prose.astro';

// Bump this when the resume content actually changes.
const LAST_UPDATED = new Date('2026-08-10');
---

<BaseLayout title="Resume — nebulous-code">
  <div class="container-narrow">
    <PageHeader
      updated={LAST_UPDATED}
      title="Resume"
      lede="The short version, structured. The long version is in the projects."
    >
      <ActionLink href="/resume.pdf" size="large">download PDF</ActionLink>
    </PageHeader>

    <div class="body">
      <Prose>
        <p>For now, the projects page tells the story.</p>
      </Prose>

      <div class="page-cta">
        <ActionLink href="/projects">see projects</ActionLink>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .body {
    padding-block: var(--space-10);
  }

  /* Sits outside <Prose> so it reads as a call to action rather than another
     sentence — prose links are a different thing and carry no arrow. */
  .page-cta {
    margin-top: var(--space-9);
  }
</style>
