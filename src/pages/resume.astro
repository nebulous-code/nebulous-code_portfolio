---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Button from '~/components/Button.astro';
import PageHeader from '~/components/PageHeader.astro';
import Prose from '~/components/Prose.astro';

// Bump this when the resume content actually changes.
const LAST_UPDATED = new Date('2026-08-10');
---

<BaseLayout title="Resume — nebulous-code">
  <div class="container-narrow">
    <PageHeader
      updated={LAST_UPDATED}
      title="Resume"
      lede="The short version, structured. The long version is in the projects."
    >
      <Button variant="secondary" href="/resume.pdf">download PDF →</Button>
    </PageHeader>

    <div class="body">
      <Prose>
        <p>For now, the projects page tells the story.</p>
        <p><a href="/projects">See projects →</a></p>
      </Prose>
    </div>
  </div>
</BaseLayout>

<style>
  .body {
    padding-block: var(--space-10);
  }
</style>
