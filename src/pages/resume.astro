---
import BaseLayout from '~/layouts/BaseLayout.astro';
import ActionLink from '~/components/ActionLink.astro';
import PageHeader from '~/components/PageHeader.astro';
import Prose from '~/components/Prose.astro';

// The date on the PDF itself, not the day the page was touched — a visitor
// judging freshness cares how old the resume is.
const LAST_UPDATED = new Date('2025-06-01');
---

<BaseLayout
  title="Resume — nebulous-code"
  description="Resume for Nicholas Licalsi, full-stack developer. PDF download."
>
  <div class="container-narrow">
    <PageHeader
      updated={LAST_UPDATED}
      title="Resume"
    >
      <Fragment slot="lede">
        The resume, because I've got to fit myself on a page. <a href="/projects">The projects</a>, because I've got more to show.
      </Fragment>
      <ActionLink href="/resume.pdf" size="large">download PDF</ActionLink>
    </PageHeader>

    <div class="body">
      <Prose>
        <p>For now, the projects page tells the story.</p>
      </Prose>

      <div class="page-cta">
        <ActionLink href="/projects">see projects</ActionLink>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .body {
    padding-block: var(--space-10);
  }

  /* Sits outside <Prose> so it reads as a call to action rather than another
     sentence — prose links are a different thing and carry no arrow. */
  .page-cta {
    margin-top: var(--space-9);
  }
</style>
