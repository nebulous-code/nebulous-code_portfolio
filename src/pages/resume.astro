---
import BaseLayout from '~/layouts/BaseLayout.astro';
import ActionLink from '~/components/ActionLink.astro';
import PageHeader from '~/components/PageHeader.astro';
import Prose from '~/components/Prose.astro';

// The date on the PDF itself, not the day the page was touched — a visitor
// judging freshness cares how old the resume is.
const LAST_UPDATED = new Date('2025-06-01');
---

<BaseLayout
  title="Resume — nebulous-code"
  description="Resume for Nicholas Licalsi, full-stack developer. PDF download."
>
  <div class="container-narrow">
    <PageHeader
      updated={LAST_UPDATED}
      title="Resume"
      lede="The resume, because I've got to fit myself on a page. The projects, because I've got more to show."
    >
      <ActionLink href="/resume.pdf" size="large">download PDF</ActionLink>
    </PageHeader>

    <div class="body">
      <Prose>
        <p>
          As a software professional with a decade of experience I've worked as a full-stack SaaS developer building reports, completed custom development for enterprise clients, and built in-house tools for the company that runs them.
        </p>

        <p>
          Beyond development I've worked as a product manager at a property management company. There I sat with clients to design reports, ran scrum ceremonies for my team, and presented release risks to executives. Earlier than that I opened a coworking space, which included modeling revenue against rent and projecting membership prices before customers walked through the door.
        </p>

        <p>
          The through line of my career has always been analytics and reporting. I design reports that show actionable metrics, optimize the process of report generation, and coalesce data across systems that weren't meant to talk to each other.
        </p>

        <p>
          I'm not currently looking to leave where I am, but I am always interested to hear about unusual problems.
        </p>
      </Prose>

      <div class="page-cta">
        <ActionLink href="/about" tone="muted">about me</ActionLink>
        <ActionLink href="/projects">see projects</ActionLink>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .body {
    padding-block: var(--space-10);
  }

  /* Sits outside <Prose> so it reads as a call to action rather than another
     sentence — prose links are a different thing and carry no arrow. */
  .page-cta {
    margin-top: var(--space-9);
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: var(--space-5);
  }
</style>
