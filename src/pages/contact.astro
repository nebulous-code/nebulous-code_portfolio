---
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHeader from '~/components/PageHeader.astro';
import KpiGrid from '~/components/KpiGrid.astro';
import KpiCell from '~/components/KpiCell.astro';

const EMAIL = 'me@nebulouscode.com';
const GITHUB_URL = 'https://github.com/nebulous-code';
const GITHUB_HANDLE = '@nebulous-code';
const LINKEDIN_URL = 'https://www.linkedin.com/in/licalsinj';
const LINKEDIN_HANDLE = 'licalsinj';
---

<BaseLayout
  title="Contact — nebulous-code"
  description="Get in touch with Nicholas Licalsi by email, GitHub, or LinkedIn."
>
  <div class="container-narrow">
    <PageHeader
      title="Contact"
      lede="The fastest way to reach me is email. I'm also on GitHub and occasionally LinkedIn."
    />

    <div class="body">
      <div class="contact-grid">
        <KpiGrid columns={3}>
          <KpiCell label="email">
            <a class="cell-link" href={`mailto:${EMAIL}`}>{EMAIL}</a>
          </KpiCell>
          <KpiCell label="github">
            <a class="cell-link" href={GITHUB_URL} target="_blank" rel="noopener">
              {GITHUB_HANDLE}
            </a>
          </KpiCell>
          <KpiCell label="linkedin">
            <a class="cell-link" href={LINKEDIN_URL} target="_blank" rel="noopener">
              {LINKEDIN_HANDLE}
            </a>
          </KpiCell>
        </KpiGrid>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .body {
    padding-block: var(--space-10);
  }

  .cell-link {
    color: var(--color-blue);
    text-decoration: none;
  }

  .cell-link:hover {
    text-decoration: underline;
  }

  /*
   * KpiGrid sets grid-template-columns inline; override on mobile so the
   * three cells stack into one column instead of squishing.
   */
  @media (max-width: 640px) {
    .contact-grid :global(.kpi-grid) {
      grid-template-columns: 1fr !important;
    }
  }
</style>
