---
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHeader from '~/components/PageHeader.astro';
import ProjectCard from '~/components/ProjectCard.astro';
import { GITHUB_USERNAME } from '~/config/projects';
import { getAllProjects, getLatestProjectUpdate } from '~/lib/content';
import { getProjectActivity, getProjectStats } from '~/lib/github';

const projects = await getAllProjects();
const [projectActivity, projectStats, latestUpdate] = await Promise.all([
  getProjectActivity(GITHUB_USERNAME),
  getProjectStats(GITHUB_USERNAME),
  getLatestProjectUpdate(),
]);
const activityByRepo = new Map(projectActivity.map((p) => [p.repo, p]));
const statsByRepo = new Map(projectStats.map((s) => [s.repo, s]));
---

<BaseLayout
  title="Projects — nebulous-code"
  description="Software projects by Nicholas Licalsi, each with a written summary and live GitHub stats."
>
  <div class="container-wide">
    <PageHeader
      updated={latestUpdate}
      title="Projects"
      lede="When I'm not building software, I'm showing it off here. Maybe you'll find a project you like. If so, let me know."
    />

    {/* TODO M5: tag filter */}

    <section class="section">
      <div class="project-grid">
        {projects.map((project) => (
          <ProjectCard
            project={project}
            activity={activityByRepo.get(project.repo)}
            stats={statsByRepo.get(project.repo)}
          />
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .section {
    padding-block: var(--space-10);
  }

  .project-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-7);
  }

  @media (min-width: 800px) {
    .project-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
