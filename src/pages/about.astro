---
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHeader from '~/components/PageHeader.astro';
import Prose from '~/components/Prose.astro';

// Bump this when the copy below actually changes.
const LAST_UPDATED = new Date('2026-08-10');
---

<BaseLayout title="About — nebulous-code">
  <div class="container-narrow">
    <PageHeader
      updated={LAST_UPDATED}
      title="About"
      lede="I'm Nicholas — a software developer with about a decade of experience across web development, scrum/product work, and senior engineering roles."
    />

    <div class="body">
      <Prose>
        <p>
          I currently work at a home inspection company building reporting tools, internal developer tooling, and full-stack web applications.
        </p>

        <p>
          My happy place is the seam between "build the thing" and "understand what the thing should do." That's why I'm drawn to reporting and analytics work — it sits exactly there. Outside of my day job I run a small publishing company, write fiction, and build tools for hobbies I refuse to take seriously (the Pokémon TCG dashboard, Rubik's cube practice apps, emulators).
        </p>
      </Prose>
    </div>
  </div>
</BaseLayout>

<style>
  .body {
    padding-block: var(--space-10);
  }
</style>
